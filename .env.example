# =============================================================================
# SEC Platform — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The demo build runs fine with ONLY DATABASE_URL present.
# =============================================================================

# --- Database (PostgreSQL via Supabase or Railway) ---------------------------
# Full connection string for the app's database. Used by Drizzle (src/db).
# Get it from your Supabase/Railway dashboard → "Connection string".
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# --- Auth (managed provider: Supabase Auth or Clerk) --------------------------
# Signing secret for sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Public URL where the app is hosted (used in email/WhatsApp deep links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File storage (S3-compatible: AWS S3, Cloudflare R2) ----------------------
# Bucket + credentials for evidence uploads (photos, PDFs). Presigned uploads
# go straight from the browser to storage, keeping servers out of the data path.
S3_BUCKET="sec-evidence"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""             # e.g. https://<account>.r2.cloudflarestorage.com

# --- Email (SendGrid) ---------------------------------------------------------
# API key for automatic + manual email (welcome, reminders, feedback-ready).
SENDGRID_API_KEY=""
SENDGRID_FROM="SEC Platform <no-reply@schoolenterprisechallenge.org>"

# --- WhatsApp Business API ----------------------------------------------------
# Meta WhatsApp Cloud API credentials for WhatsApp reminders/confirmations.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Push notifications (for the Capacitor mobile apps) -----------------------
# Firebase Cloud Messaging key used to send push for the same events as 5.6.
FCM_SERVER_KEY=""
